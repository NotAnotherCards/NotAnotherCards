# Prometheus, Grafana, and Alertmanager Ports (Internal / Loopback on VPS)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.notanothercards.com

# Postgres Exporter Connection String
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://your-user:your-password@postgres:5432/notanothercards?sslmode=disable

# Slack Incoming Webhook URL (required; kept in this mode-600 file and
# mounted into Alertmanager as a Compose secret, not as a container env var)
SLACK_WEBHOOK_URL=

# GX10 scrape mode: "proxy" today, "tailnet" after #193.
# proxy: HTTPS through ai.dustyway.org
# tailnet: direct HTTP to ports 4000, 9400, and 9100 on this host
GX10_METRICS_MODE=proxy
GX10_METRICS_HOST=ai.dustyway.org
