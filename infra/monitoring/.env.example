# Prometheus and Grafana Ports (Internal / Loopback on VPS)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-secure-admin-password
GRAFANA_ROOT_URL=https://grafana.notanothercards.com

# Postgres Exporter Connection String
# Connects to the local PostgreSQL instance on the VPS
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://your-user:your-password@127.0.0.1:5432/notanothercards?sslmode=disable

# GX10 Supercomputer Tailscale IP (for scraping LiteLLM, node-exporter, and DCGM GPU exporter)
GX10_TAILSCALE_IP=100.64.0.1
