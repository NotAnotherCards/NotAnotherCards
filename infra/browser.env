# Disposable browser-test credentials; never use a developer database or .env.
POSTGRES_USER=browser
POSTGRES_PASSWORD=browser-test-only
POSTGRES_DB=browser
POSTGRES_PORT=55432
DATABASE_URL=postgresql://browser:browser-test-only@postgres:5432/browser
API_PORT=3000
WEB_PORT=4173
LANDING_PORT=4174
BETTER_AUTH_SECRET=browser-tests-only-secret-252-never-use-in-production
BETTER_AUTH_URL=http://localhost:4173
# nginx appends the Docker bridge client address to the test client's header.
BETTER_AUTH_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
FRONTEND_URL=http://localhost:4173
AI_API_BASE=
AI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_MOCK=
AI_DEFAULT_MODEL=
MODERATION_ALLOW_ALL=
MODERATION_OPERATOR_KEY=
MODERATION_MAX_DAILY_REPORTS_PER_USER=10
MODERATION_RECHECK_WINDOW_HOURS=24
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@notanothercards.com
SMTP_USER=
SMTP_PASSWORD=
