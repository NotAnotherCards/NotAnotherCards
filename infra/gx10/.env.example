# tailscale IP of the GX10; litellm and the exporters bind to it
TAILSCALE_IP=100.64.0.1

# admin key for litellm (minting virtual keys, admin API). Never used by
# clients — teammates and the production worker get virtual keys.
LITELLM_MASTER_KEY=

# password for litellm's own postgres (virtual key storage)
LITELLM_DB_PASSWORD=
