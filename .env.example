# Published service ports
WEB_PORT=5173
API_PORT=3000
POSTGRES_PORT=5432

# Postgres service
POSTGRES_USER=your-user
POSTGRES_PASSWORD=your-password
POSTGRES_DB=notanothercards
# Keep user/password/db in sync with the values above (and with apps/api/.env)
DATABASE_URL=postgresql://your-user:your-password@postgres:5432/notanothercards

# Better Auth and browser origin. If WEB_PORT changes, update both URLs
BETTER_AUTH_SECRET=replace-with-your-random-secret
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional OpenAI-compatible AI gateway
AI_API_BASE=
AI_API_KEY=
