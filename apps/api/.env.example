# Backend
PORT=3000

# Database
# PostgreSQL credentials must match docker-compose.yml
DATABASE_URL=postgresql://your-user:your-password@localhost:5432/notanothercards
# Optional integration-test base connection. The role must be allowed to
# create and drop databases. Remove this line to fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://your-user:your-password@localhost:5432/postgres

# Better Auth
# generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret
BETTER_AUTH_URL=http://localhost:3000

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Optional OpenAI-compatible AI gateway
AI_API_BASE=
AI_API_KEY=
AI_DEFAULT_MODEL=gemma4
AI_WORKER_ENABLED=true
AI_WORKER_POLL_INTERVAL_MS=2000
AI_MAX_PENDING_JOBS_PER_USER=2
AI_MAX_DAILY_TOKENS_PER_USER=50000
AI_MAX_DAILY_REQUESTS_PER_USER=25


# Google credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# Email Delivery Configuration (Resend or SMTP)
# For development custom SMTP:
SMTP_HOST=localhost # Set to "mail" if running inside Docker Compose
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@notanothercards.com
SMTP_USER=
SMTP_PASSWORD=
# For production (Resend)
RESEND_API_KEY=
