# Backend
PORT=3000

# Database
# PostgreSQL credentials must match docker-compose.yml
DATABASE_URL=postgresql://your-user:your-password@localhost:5432/notanothercards
# Optional integration-test base connection. The role must be allowed to
# create and drop databases. Remove this line to fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://your-user:your-password@localhost:5432/postgres

# Better Auth
# generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret
BETTER_AUTH_URL=http://localhost:3000

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Optional OpenAI-compatible AI gateway
AI_API_BASE=
AI_API_KEY=

# Google credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


